# Keycloak 런타임 위치 (scripts/start-keycloak.ps1 에서 사용)
KEYCLOAK_HOME=C:\Users\<you>\sso-tools\keycloak-26.8.2
JAVA_HOME=C:\Users\<you>\sso-tools\jdk-21.0.13+9

# Keycloak 관리자 콘솔 계정 (최초 기동 시 생성)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# 실습용 테스트 사용자 alice 의 비밀번호 (realm import 시 주입)
SSO_TEST_PASSWORD=change-me

# Keycloak realm 의 issuer
KEYCLOAK_ISSUER=http://localhost:8080/realms/sso-lab

# 서비스 A (SecureNote)
SERVICE_A_PORT=3001
SERVICE_A_BASE_URL=http://service-a.localhost:3001
SERVICE_A_CLIENT_SECRET=change-me
SERVICE_A_SESSION_SECRET=change-me

# 서비스 B (SignDesk)
SERVICE_B_PORT=3002
SERVICE_B_BASE_URL=http://service-b.localhost:3002
SERVICE_B_CLIENT_SECRET=change-me
SERVICE_B_SESSION_SECRET=change-me
